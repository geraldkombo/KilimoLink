generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  name         String
  role         Role     @default(FARMER)
  passwordHash String?
  createdAt    DateTime @default(now())
  
  products  Product[]
  orders    Order[]
  
  // Keep relations for existing modules if they still exist
  otps      OtpChallenge[]
  notifications NotificationLog[]
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float
  quantity    Float
  category    String        // Vegetables, Fruits, Dairy, Grains, Other 
  imageUrl    String?
  location    Json?         // { lat: Float, lng: Float, address: String? } 
  farmerId    String
  farmer      User          @relation(fields: [farmerId], references: [id])
  createdAt   DateTime      @default(now())
  
  orderItems  OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  buyerId        String
  buyer          User        @relation(fields: [buyerId], references: [id])
  status         OrderStatus @default(PENDING)
  paymentMethod  String?     // "MOCK", "CRYPTO", "CASH" 
  paymentRef     String?
  totalAmount    Float
  createdAt      DateTime    @default(now())
  
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float
  price     Float
}

model ImpactMetric {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  ordersCompleted Int
  co2SavedKg      Float
  wasteDivertedKg Float
  greenSpaceM2    Float
}

model ResilienceLog {
  id          String   @id @default(cuid())
  type        String   // "REGULATORY", "EXPERIMENT", "MARKET_SHIFT"
  title       String
  description String
  impact      String   // "POSITIVE", "NEGATIVE", "NEUTRAL"
  status      String   // "MONITORED", "RESOLVED", "IN_PROGRESS"
  createdAt   DateTime @default(now())
}

// Keep these for existing auth/admin functionality
model OtpChallenge {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
}

model OtpVerifyThrottle {
  id          String   @id @default(cuid())
  phone       String
  failures    Int      @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([phone])
}

model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  role            String    @default("ADMIN")
  county          String?
  totpSecretEnc   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  auditLogs       AuditLog[]
  loginThrottles  AdminLoginThrottle[]
}

model AdminLoginThrottle {
  id          String   @id @default(cuid())
  adminEmail  String
  ip          String?
  failures    Int      @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminEmail, updatedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entityType String
  entityId  String?
  payload   Json
  ip        String?
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

enum NotificationChannel {
  SMS
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model NotificationLog {
  id        String              @id @default(cuid())
  userId    String?
  phone     String?
  channel   NotificationChannel
  template  String
  payload   Json
  status    NotificationStatus @default(QUEUED)
  error     String?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
