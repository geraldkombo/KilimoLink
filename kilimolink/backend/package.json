  "version": "0.1.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:e2e": "jest --config jest.config.cjs --runInBand",
