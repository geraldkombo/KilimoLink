{
  "name": "kilimolink-platform-final",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "postinstall": "pnpm --filter @kilimolink/backend prisma:generate || true",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @kilimolink/backend start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
